{
  "name": "ddn",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "DDN — Deterministic Decision Network",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:rust": "cargo test --workspace --exclude ddn-validator && cargo test -p ddn-validator",
    "build:policy": "./scripts/build-policy.sh",
    "test:vectors": "cargo test -p ddn-canonical-json -p ddn-crypto -p ddn-negotiation-v1 -p ddn-validator",
    "test:determinism": "cargo build --release -p ddn-validator && ./target/release/ddn-validator determinism-check --policy policies/negotiation-v1/package --input packages/test-vectors/fixtures/negotiation-counter.json --runs 1000",
    "policy:reproducibility": "./scripts/policy-reproducibility.sh",
    "policy:reproducibility:negative-tests": "./scripts/policy-reproducibility-negative-tests.sh",
    "verify:milestone-2": "./scripts/verify-milestone-2.sh",
    "public-release-check": "node scripts/public-release-check.mjs --mode git-worktree",
    "test:public-release": "node --test scripts/public-snapshot-files.test.mjs && node scripts/public-release-check.mjs --self-test",
    "secrets:gitleaks": "node scripts/gitleaks-gate.mjs",
    "secrets:trufflehog": "node scripts/trufflehog-gate.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "licenses:report": "node scripts/dependency-license-report.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
