{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ddn.mikko-lab.dev/schemas/policy-manifest-v1.schema.json",
  "title": "PolicyManifestV1",
  "description": "A DDN policy package's manifest.json. Every *Hash field is independently recomputed from the actual file on disk by the validator (apps/validator/src/package.rs) before the package is trusted -- never taken on the manifest's own word. manifestHash (see docs/validator-result-v1.md) is the canonical hash of this document with createdAt removed, since createdAt is expected to vary between otherwise-identical builds (see docs/reproducible-builds.md) and must not affect it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "policyId",
    "policyVersion",
    "publisherId",
    "entrypoint",
    "executionProfileId",
    "inputSchemaHash",
    "outputSchemaHash",
    "reasonCodeRegistryHash",
    "wasmHash",
    "testVectorHash",
    "createdAt"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0.0"
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "publisherId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "executionProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputSchemaHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outputSchemaHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reasonCodeRegistryHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "wasmHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "testVectorHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
