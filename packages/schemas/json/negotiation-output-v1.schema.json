{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ddn.mikko-lab.dev/schemas/negotiation-output-v1.schema.json",
  "title": "NegotiationOutputV1",
  "description": "DDN negotiation-v1 policy output. Structural/type constraints only; the cross-field invariants (counterOfferCents null iff decision is ACCEPT/REJECT, humanReviewRequired true iff decision is ESCALATE, no duplicate reason codes) are enforced separately at runtime (see packages/schemas/src/index.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "counterOfferCents", "reasonCodes", "humanReviewRequired"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "decision": {
      "enum": ["ACCEPT", "COUNTER", "REJECT", "ESCALATE"]
    },
    "counterOfferCents": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "enum": [
          "OFFER_AT_OR_ABOVE_LIST",
          "OFFER_AT_OR_ABOVE_FLOOR",
          "OFFER_BELOW_FLOOR",
          "FINAL_COUNTER_AVAILABLE",
          "OFFER_LIMIT_REACHED",
          "CONDITION_REPORT_NOT_ACKNOWLEDGED",
          "INVALID_PRICE_RELATION",
          "POLICY_NOT_EFFECTIVE",
          "HUMAN_REVIEW_REQUIRED"
        ]
      }
    },
    "humanReviewRequired": {
      "type": "boolean"
    }
  }
}
