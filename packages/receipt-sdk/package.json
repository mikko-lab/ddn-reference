{
  "name": "@ddn/receipt-sdk",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "cd dist && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors:generate": "node dist/generate-merkle-vectors.js --confirm-update",
    "vectors:check": "node dist/generate-merkle-vectors.js --check"
  },
  "dependencies": {
    "@ddn/canonical-json": "workspace:*",
    "@ddn/crypto": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
