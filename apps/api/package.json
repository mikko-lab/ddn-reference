{
  "name": "@ddn/api",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ddn-api": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "cd dist && node --test",
    "test:integration": "node --test dist/decisions/decision-runner.test.js dist/external-client-e2e.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "node dist/openapi/generate-openapi.js --confirm-update",
    "openapi:check": "node dist/openapi/generate-openapi.js --check"
  },
  "dependencies": {
    "@ddn/anchor-service": "workspace:*",
    "@ddn/canonical-json": "workspace:*",
    "@ddn/coordinator": "workspace:*",
    "@ddn/crypto": "workspace:*",
    "@ddn/receipt-sdk": "workspace:*",
    "@ddn/schemas": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@ddn/client-sdk": "workspace:*",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
